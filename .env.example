# Worker environment (set in your Site's environment settings — never commit real values)
ADMIN_EMAIL=you@example.com           # the Super Admin's sign-in email (exact match, case-insensitive)
SITE_URL=https://your-site.example    # canonical origin for sitemap, OG tags, RSS, ICS (recommended)
AI_WEBHOOK_SECRET=                    # long random string; enables POST /api/hooks/editorial-run (run log in Admin)
ANALYTICS_SALT=                       # random string; salts the daily anonymous visitor hash
SECURITY_CONTACT=mailto:security@your-site.example   # serves /.well-known/security.txt
# FRAME_ANCESTORS='self' https://chatgpt.com https://*.chatgpt.com   # who may embed the site
# EDITORIAL_URL=https://raw.githubusercontent.com/<you>/<repo>/main/data/editorial.json

# GitHub Actions (Settings → Secrets and variables) for the hourly workflow
# secrets: OPENAI_API_KEY or ANTHROPIC_API_KEY, AI_WEBHOOK_SECRET   variables: SITE_URL, AI_PROVIDER, AI_MODEL

# Optional Google student login (Web application OAuth credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_STATE_SECRET=       # random value with at least 32 bytes of entropy
# Authorized redirect URI: <SITE_URL>/auth/google/callback

# Optional email delivery
RESEND_API_KEY=
REMINDER_FROM=             # sender on a verified Resend domain
ADMISSION_JOB_SECRET=      # same long random secret in Sites and GitHub Actions
# GitHub Actions: set SITE_URL as a repository variable and ADMISSION_JOB_SECRET as a secret.
